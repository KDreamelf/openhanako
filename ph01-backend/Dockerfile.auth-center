FROM golang:1.26.1-alpine AS builder

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags "-s -w" -o /out/auth-center ./cmd/auth-gateway

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /app
COPY --from=builder /out/auth-center /usr/local/bin/auth-center

EXPOSE 8080 8443
ENTRYPOINT ["auth-center"]
